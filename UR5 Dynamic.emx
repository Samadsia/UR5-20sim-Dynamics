            text 'TF' 440 384 color 0 18 bold;
          end;
          implementation eq
parameters
	
	// Import of global variables
	real global d[6];         	
	real global r_G3[3];        
	integer global link;			  

equations
	
	// Computation of (skew(r_GB)*omega_B)
	p2.e = transpose(skew([0;0;d[link+1]] - r_G3)) * p1.e;
	p1.f = skew([0;0;d[link+1]] - r_G3) * p2.f;
implementation_end;
