           restrictions
            causality fixed out p;
          end;
          icon bg ellipse top
           figures
            text 'Se' 256 240 color 0 18 bold;
          end;
          implementation eq
parameters
	real global m[6];					// Masses vector
	integer global link;				// Link index
	real global gravity;
	real effort[3] = [0; 0; -9.81  * gravity * m[link]];		// Vertical gravity
	
variables
	real flow[3];

equations
	p.e = effort;
	flow = p.f;
implementation_end;
