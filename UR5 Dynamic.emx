	effort = first (p.e);
implementation_end;
        end;
        connections
         A => OneJunction\p;
         C\p <= ZeroJunction\p;
         OneJunction\p => I\p;
         OneJunction\p => R\p;
         OneJunction\p => TF\p1;
         OneJunction1\p => B;
         OneJunction1\p => R1\p;
         TF\p2 => ZeroJunction\p;
         ZeroJunction\p => OneJunction1\p;
        end;
       implementation_end;
