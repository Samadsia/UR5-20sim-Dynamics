            signal out tau;
          end;
          icon bg bottom
           figures
            rectangle 552 96 600 128 color 0 fill 16777215;
            text 'filedata' 574.4 112 color 0;
          end;
          implementation eq
// 20-sim User Editor
// DataFromFile.dll
/* CONFIGURATION
DataVariable false "time" timeData 1 0
DataVariable false "position" position 1 0
DataVariable false "velocity" velocity 1 0
DataVariable false "acceleration" acceleration 1 0
DataVariable true "tau" tau 1 0
SelectionVariable time 1
OffsetFirstDataPoint false
FindRowValueInColumn 0
StopSimulationAtEOF false
END CONFIGURATION */
parameters
	string fileName = 'joint_6_with_tau.csv';
variables
	real hidden dataFileId;
	real hidden dll_read_inputs[4];

initialequations
	dataFileId = dll('DataFromFile.dll', 'InitializeDataFile', fileName);
code

	dll_read_inputs = [dataFileId; time; 0; 4];
	tau = dll('DataFromFile.dll', 'GetDataValue', dll_read_inputs);
implementation_end;
        end;
        connections
         Gain\output -> PlusMinus1\plus;
         input -> PlusMinus\minus;
         MSe\p => output;
         PID\output -> PlusMinus1\plus;
         PlusMinus\output -> PID\error;
         PlusMinus1\output -> MSe\effort;
         Position\position -> PlusMinus\plus;
         torque\tau -> Gain\input;
        end;
       implementation_end;
      GravityComp 496 476
       description '<Information><Description><Version>4.0</Version><IsMainModel>1</IsMainModel><KeepParameterValues>False</KeepParameterValues><AllowLibraryUpdate>True</AllowLibraryUpdate></Description></Information>';
       type GravityComp
        ports
         signal in q2;
         signal in q3;
         signal out G2;
         signal out G3;
       end;
       icon bg
        figures
         rectangle 456 444 536 508 color 0 fill 6008319;
         text 'Ggrav' 496 476 color 0 16 bold;
       end;
       implementation eq
parameters
	// Gravity feedforward for the shoulder (joint 2) and elbow (joint 3).
	// 1 = on, 0 = off (compare tracking with and without it)
	real gravity_comp = 0;
	// Motor-side scaling: same value/sign as the Gain used for the recorded torque
	real Kgrav = -1.0/100.0;
	real g = 9.81;
	// UR5 data (same values as the model's global parameters)
	real a2 = -0.425;
	real a3 = -0.39225;
	real m2 = 8.393;
	real m3 = 2.33;
	real Mw = 2.4317;	// wrist lump: m4 + m5 + m6
	real rG2x = 0.2125;
	real rG3x = 0.15;
equations
	// Joints 2,3 have parallel axes, so the arm is planar for gravity purposes.
	// P = g*[m2*rG2x*sin(q2) + m3*(a2*sin(q2)+rG3x*sin(q2+q3)) + Mw*(a2*sin(q2)+a3*sin(q2+q3))]
	// G2 = dP/dq2 , G3 = dP/dq3
	G2 = gravity_comp * Kgrav * g * (m2*rG2x*cos(q2) + m3*(a2*cos(q2) + rG3x*cos(q2+q3)) + Mw*(a2*cos(q2) + a3*cos(q2+q3)));
	G3 = gravity_comp * Kgrav * g * ((m3*rG3x + Mw*a3) * cos(q2+q3));
implementation_end;
      H_Drive1 112 232
       description '<Information><Description><Version>4.0</Version><LibraryPath>System\Submodel.emx</LibraryPath><TimeStamp>2007-10-31 11:32:54</TimeStamp><IsMainModel>1</IsMainModel><KeepParameterValues>False</KeepParameterValues><AllowLibraryUpdate>True</AllowLibraryUpdate></Description></Information>';
       type Submodel
        ports
         power in A;
         power out B;
       end;
       icon bg
        figures
         rectangle 64 216 160 248 color 0 fill 2124031;
         text 'name' 112 232 color 0 16;
       end;
       implementation bg
        submodels
         C 392 168
          description '<Information>
 <Description>
    <Version>4.2</Version>
<IsMainModel>1</IsMainModel>
  <KeepParameterValues>False</KeepParameterValues>
    <LibraryPath>Bond Graph\C.emx</LibraryPath>
  <TimeStamp>2011-11-29 15:58:35</TimeStamp>
</Description>
</Information>';
          type C
           ports
            power in p;
            signal out state;
           restrictions
            causality preferred out p;
          end;
          icon bg ellipse
           figures
            text 'C' 392 168 color 0 18 bold;
          end;
          implementation eq
variables
   real phi1;
   real phi2;

parameters
	real k1 = 16e3;
	real k2 = 25e3;
	real k3 = 29e3;
	real T1 = 7;
	real T2 = 25;

equations
	state = int(p.f); // state phi
	
   phi1 = T1/k1;
   phi2 = T1/k1 + (T2-T1)/k2; 

	if state <= phi1 or state >= -phi1 then   // first region
		p.e = state * k1;
	 
	elsif state > phi2 or state < -phi2 then // third region
		p.e = (state -sign(state)*phi2)*k3 +sign(state)*T2;
		
	else // second region
		p.e = (state -sign(state)*phi1)*k2 +sign(state)*T1;
	end;
implementation_end;
         I 232 176
          description '<Information>
 <Description>
    <Version>4.2</Version>
<IsMainModel>1</IsMainModel>
  <KeepParameterValues>False</KeepParameterValues>
    <LibraryPath>Bond Graph\I.emx</LibraryPath>
  <TimeStamp>2011-11-29 15:55:55</TimeStamp>
</Description>
</Information>';
          type I
           ports
            power in p;
            signal out state;
           restrictions
            causality preferred in p;
          end;
          icon bg ellipse
           figures
            text 'I' 232 176 color 0 18 bold;
          end;
          implementation eq
parameters
	real i = 0.404e-4; //from datasheet
equations
    state = int(p.e);
    p.f = state / i; //rotational velocity 
implementation_end;
