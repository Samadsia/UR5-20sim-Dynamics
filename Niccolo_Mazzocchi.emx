          end;
          implementation eq
parameters
	
	// Import of global variables
	real global d[6];         	  
	real global r_G1[3];        
	integer global link;			 

equations
	
	// Computation of (skew(r_GB)*omega_B)
	p1.e = transpose(-skew([0;0;d[link+1]] - r_G1)) * p2.e;
	p2.f = (-skew([0;0;d[link+1]] - r_G1)) * p1.f;
implementation_end;
