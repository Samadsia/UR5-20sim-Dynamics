      Link5 768 152
       description '<Information><Description><Version>4.0</Version><LibraryPath>Template\Submodel-Graphical.emx</LibraryPath><IsMainModel>1</IsMainModel><KeepParameterValues>True</KeepParameterValues><TimeStamp>2007-11-1 22:32:34</TimeStamp><AllowLibraryUpdate>False</AllowLibraryUpdate></Description><Attributes><GlobalRelations>parameters
	// Index for the link
	integer link = 5;

	// Import of global variables
	real global alpha[6];
	real global r_G5[3];

	real T_alpha [4, 4];

	// Inertia matrix
  	real J5[3,3] = [0.0067, 0, 		0;
						 0, 		0.00640, 0;
						 0, 		0, 		0.0067]; 
	
initialequations
	T_alpha = [1, 0, 						0, 					0;
     			  0, cos(alpha[link]), -sin(alpha[link]), 0;
     			  0, sin(alpha[link]),  cos(alpha[link]), 0;
				  0, 0, 						0, 					1];
</GlobalRelations></Attributes></Information>';
       type 'Link-Graphical'
        ports
         translation in A_lin [3,1];
         rotation in A_ang [3,1];
         translation out B_lin [3,1];
         rotation out B_ang [3,1];
       end;
       icon bg
        figures
         rectangle 744 136 792 168 color 0 fill 15132390;
         text 'name' 768 152 color 0 16;
        terminals
         A_lin 740 146 fixed;
         A_ang 740 158 fixed;
         B_lin 796 146 fixed;
         B_ang 796 158 fixed;
       end;
       implementation bg
        submodels
         EE 352 344
          description '<Information><Description><Version>4.0</Version><LibraryPath>Template\Submodel-Equation.emx</LibraryPath><IsMainModel>1</IsMainModel><KeepParameterValues>False</KeepParameterValues><TimeStamp>2007-11-1 22:32:1</TimeStamp><AllowLibraryUpdate>False</AllowLibraryUpdate></Description></Information>';
          type 'Submodel-Equation'
           ports
            translation in G_lin [3,1];
            rotation in G_rot [3,1];
            signal out R [3,3];
            signal out p_OG5 [3,1] {m} ;
          end;
          icon bg
           figures
            rectangle 336 328 368 360 color 0 fill 15132390;
            text 'name' 352 344 color 0 16;
           terminals
            G_lin 352 320 fixed;
            G_rot 352 368 fixed;
            R 376 344 fixed;
          end;
          implementation eq
parameters

	// Import of global variables
	real global m[6]; 				
	integer global link;				
	real global J5[3,3]; 			
	real global T05_init[4,4];		
	real global p_OG5_init[3];		

variables
	
	real p[3]; 							// Linear momentum
	real h[3]; 							// Angular momentum
	real R_init[3,3];					// Initial rotation matrix
	
initialequations 

	// Extraction of inital rotation matrix
	R_init = T05_init[1:3,1:3];	

equations

	// Computation of rotation matrix
	R = int(R * skew(G_rot.omega), R_init);	

	// Computation of CoM position wrt Base frame
	p_OG5 = int(R * G_lin.v, p_OG5_init);			

	// Computation of linear and angular momentum
	p = int(G_lin.F - skew(G_rot.omega) * p);		
	h = int(G_rot.T - skew(G_rot.omega) * h);		

	// Computation of linear and angular velocity
	G_lin.v = (1/m[link]) * p;									
	G_rot.omega = inverse(J5) * h;
	


   
 implementation_end;
         Gravity 256 192
          description '<Information><Description><Version>4.2</Version><IsMainModel>1</IsMainModel><KeepParameterValues>False</KeepParameterValues><LibraryPath>Bond Graph\Se.emx</LibraryPath><TimeStamp>2011-11-29 16:36:49</TimeStamp><AllowLibraryUpdate>True</AllowLibraryUpdate></Description></Information>';
          type Se
           ports
            power out p [3,1];
           restrictions
            causality fixed out p;
          end;
          icon bg ellipse top
           figures
            text 'Se' 256 192 color 0 18 bold;
          end;
          implementation eq
parameters
	real global m[6];					// Masses vector
	integer global link;				// Link index
	real global gravity;
	real effort[3] = [0; 0; -9.81  * gravity * m[link]];		// Vertical gravity
	
variables
	real flow[3];

equations
	p.e = effort;
	flow = p.f;
implementation_end;
