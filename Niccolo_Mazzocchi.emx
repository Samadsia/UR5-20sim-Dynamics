            power out p2 [3,1];
           restrictions
            causality constraint not_equal p1 p2;
          end;
          icon bg ellipse bottom
           figures
            text 'TF' 440 408 color 0 18 bold;
          end;
          implementation eq
parameters
	
	// Import of global variables
	real global d[6];         	 
	real global r_G5[3];        
	integer global link;			

equations
	
	// Computation of (skew(r_GB)*omega_B)
	p2.e = transpose(skew([0;0;d[link+1]] - r_G5)) * p1.e;
	p1.f = skew([0;0;d[link+1]] - r_G5) * p2.f;
implementation_end;
