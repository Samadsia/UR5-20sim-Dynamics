	// Extraction of inital rotation matrix
	R_init = T04_init[1:3,1:3];	

equations
	
	// Computation of rotation matrix
	R = int(R * skew(G_rot.omega), R_init);			

	// Computation of CoM position wrt Base frame
	p_OG4 = int(R * G_lin.v, p_OG4_init);			

	// Computation of linear and angular momentum
	p = int(G_lin.F - skew(G_rot.omega) * p);		
	h = int(G_rot.T - skew(G_rot.omega) * h);	

	// Computation of linear and angular velocity
	G_lin.v = (1/m[link]) * p;									
	G_rot.omega = inverse(J4) * h;
	


   
 implementation_end;
